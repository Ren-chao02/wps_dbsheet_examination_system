# ---- 数据库 / Redis ----
DATABASE_URL="postgresql://user:pass@localhost:5432/exam?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- JWT ----
JWT_SECRET="dev-secret"
JWT_EXPIRES_IN="24h"
# 勾选「7 天内免登录」时使用的有效期（不勾选仍用 JWT_EXPIRES_IN）
JWT_REMEMBER_EXPIRES_IN="7d"

# ---- 登录安全 ----
# 账号连续失败 N 次后锁定 M 分钟；IP 只对失败请求限流（阈值放宽，避免机房 NAT 误伤）
LOGIN_MAX_FAILED=10
LOGIN_LOCK_MINUTES=15
LOGIN_IP_LIMIT=100
LOGIN_IP_WINDOW_MINUTES=15
# 仅本地 E2E：以 NODE_ENV=production 起服务时，允许回环请求拿到验证码答案。
# 生产环境必须保持 false/不设置。
E2E_CAPTCHA_DEBUG="false"
# 注意：生产环境使用弱密钥会拒绝启动，请用 openssl rand -base64 48 生成

# ---- 部署相关（都有合理默认值，可按需覆盖）----
# 反向代理跳数。生产默认 1（信任一跳）；多级代理填跳数；直连填 false
# TRUST_PROXY=1
# 允许的跨域来源（逗号分隔）。默认放开，生产建议收敛
# CORS_ORIGINS=https://exam.example.edu.cn
# WebSocket 允许的来源（逗号分隔）。默认放开，安全性由 JWT 握手鉴权保证
# SOCKET_CORS_ORIGIN=
# 导出文件目录。默认 <进程工作目录>/exports
# EXPORT_DIR=/var/lib/exam/exports
# Docker 部署时应用端口的绑定地址。默认 127.0.0.1（配反向代理）；直连设 0.0.0.0
# APP_BIND=127.0.0.1
# 判分 Worker 并发（瓶颈在 WPS 平台限流；出现 429 就调小）
# GRADING_CONCURRENCY=6
# 首次导入种子数据时管理员/教师账号的口令（不设则随机生成并打印一次）
# ADMIN_INITIAL_PASSWORD=

# ---- 日志与错误上报（都可选，不配也不影响启动）----
# 日志级别：trace|debug|info|warn|error|fatal。生产默认 info，开发默认 debug。
# 生产输出单行 JSON（可 grep、可交给日志采集），开发输出带颜色的可读格式。
# LOG_LEVEL=info
# 错误上报（Sentry 或自建 GlitchTip 等兼容服务）。**不配就完全不启用**，
# 不产生任何网络请求——内网部署连不上 sentry.io 时，开着只会一直超时。
# 注意：请求头/请求体/用户信息/cookie 的采集已在本项目代码里显式关闭
# （学生会话里有 JWT、答案与口令），需要时再按需放开单项，别整个打开。
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# 性能数据采样率 0~1，默认 0（考试期间请求量大，全量采集既费额度又拖慢响应）
# SENTRY_TRACES_SAMPLE_RATE=0
# 发布版本号，会显示在错误报告里，便于对应到具体发版
# APP_RELEASE=

# ---- 监控栈（docker-compose.monitoring.yml，可选）----
# Uptime Kuma 的对外端口，默认 3009（仅绑定回环，经反向代理访问）
# MONITORING_PORT=3009

# ---- WPS 多维表格开放平台 ----
KINGSOFT_API_BASE_URL=""
KINGSOFT_API_KEY=""
KINGSOFT_API_SECRET=""

# ---- WPS 账号 SSO（用户授权登录）----
# 与上面的多维表格 API 凭据是两套用途；不开启时登录页自动隐藏 WPS 登录入口。
# 前置条件：WPS 开放平台应用开通用户授权 scope（kso.user_base.read）、
# 配置回调地址 ${PUBLIC_BASE_URL}/api/auth/wps/callback，并开启 KSO-1 接口签名。
WPS_SSO_ENABLED="false"
# 可留空，回退到 WPS 多维表格已配置的 APPID / APPKEY
WPS_SSO_CLIENT_ID=""
WPS_SSO_CLIENT_SECRET=""
WPS_SSO_SCOPE="kso.user_base.read"
# 服务端公网地址（反向代理后必须显式配置），用于拼接 OAuth 回调地址
PUBLIC_BASE_URL=""
# 前端公网地址；与后端同源部署时留空即可
CLIENT_BASE_URL=""
# 一般不用填，默认由 PUBLIC_BASE_URL 拼接
WPS_SSO_REDIRECT_URI=""

# ---- Phase 2：AI 对话式教练（多 provider，env 切换）----
# provider: deepseek | qwen | glm | sensenova | ollama（MVP 实装 openai-compatible，覆盖前四 + Ollama 的 OpenAI 兼容端点）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...
# 可选：自托管 OpenAI 兼容端点时覆盖（如 vLLM、Ollama 的 /v1）
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000
# 每教师限流（轮/分钟）
LLM_RATE_LIMIT_PER_MIN=20
