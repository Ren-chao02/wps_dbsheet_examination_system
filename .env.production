# ============================================================
# 金山多维表格考试系统 - 生产环境部署配置模板
#
# 部署步骤：
#   1. cp .env.production .env
#   2. 编辑 .env，至少修改 JWT_SECRET 为随机字符串
#   3. docker compose up -d
#
# ⚠️ 注意：DATABASE_URL / REDIS_URL 中的主机名必须使用
#    docker-compose 服务名 postgres / redis（不能用 localhost）
# ============================================================

# ---- 数据库 / Redis ----
DATABASE_URL="postgresql://exam_user:exam_password@postgres:5432/examination_system"
REDIS_URL="redis://redis:6379"

# ---- JWT ----
# 生成强随机密钥：openssl rand -base64 48
JWT_SECRET="please-change-me-to-a-random-secret"
JWT_EXPIRES_IN="24h"

# ---- 首次导入种子数据时的管理员/教师口令 ----
# 不填则随机生成并在容器日志里打印一次（docker compose logs app）
# ADMIN_INITIAL_PASSWORD=

# ---- 部署相关（可选）----
# 应用端口绑定地址：默认 127.0.0.1（配合同机反向代理）；学生直连本机则设 0.0.0.0
# APP_BIND=127.0.0.1
# 反向代理跳数（多级代理时调整；直连填 false）
# TRUST_PROXY=1
# 跨域白名单（逗号分隔），默认放开
# CORS_ORIGINS=
# WebSocket 允许的来源（逗号分隔）。默认放开，安全性由 JWT 握手鉴权保证
# SOCKET_CORS_ORIGIN=
# 导出目录（默认 <cwd>/exports，容器内即 /app/exports，已挂卷）
# EXPORT_DIR=

# ---- 服务器 ----
NODE_ENV=production
PORT=3002

# ---- WPS 多维表格开放平台（考试操作金山表格需要）----
KINGSOFT_API_BASE_URL="https://openapi.wps.cn/kopen/office/file"
KINGSOFT_API_KEY=""
KINGSOFT_API_SECRET=""

# ---- AI 对话式教练（Phase 2，可选）----
LLM_PROVIDER=deepseek
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000
LLM_RATE_LIMIT_PER_MIN=20
