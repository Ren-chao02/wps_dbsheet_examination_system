# Server
DATABASE_URL="postgresql://exam_user:exam_password@localhost:5432/examination_system"
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REMEMBER_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development

# 登录安全：账号失败锁定 + IP 失败限流（阈值放宽，避免机房 NAT 误伤）
LOGIN_MAX_FAILED=10
LOGIN_LOCK_MINUTES=15
LOGIN_IP_LIMIT=100
LOGIN_IP_WINDOW_MINUTES=15
# 仅本地 E2E：以 NODE_ENV=production 起服务时，允许回环请求拿到验证码答案
E2E_CAPTCHA_DEBUG="false"

# Redis
REDIS_URL="redis://localhost:6379"

# Kingsoft API (Phase 2)
KINGSOFT_API_BASE_URL="https://openapi.wps.cn/kopen/office/file"
KINGSOFT_API_KEY=""
KINGSOFT_API_SECRET=""

# WPS 账号 SSO（用户授权，与多维表格 API token 是两套东西）
WPS_SSO_ENABLED="false"
WPS_SSO_CLIENT_ID=""
WPS_SSO_CLIENT_SECRET=""
WPS_SSO_SCOPE="kso.user_base.read"
PUBLIC_BASE_URL=""
CLIENT_BASE_URL=""
WPS_SSO_REDIRECT_URI=""

# LLM / AI Coaching (Phase 2)
LLM_PROVIDER="deepseek"              # deepseek | qwen | glm | sensenova | ollama
LLM_API_KEY=""                       # sk-...
LLM_BASE_URL=""                      # 留空=用 provider 默认端点；自托管 OpenAI 兼容端点时覆盖
LLM_MODEL="deepseek-chat"
LLM_TEMPERATURE="0.4"
LLM_MAX_TOKENS="2048"
LLM_TIMEOUT_MS="60000"
LLM_RATE_LIMIT_PER_MIN="20"          # 每教师限流
