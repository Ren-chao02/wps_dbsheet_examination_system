# Server
DATABASE_URL="postgresql://exam_user:exam_password@localhost:5432/examination_system"
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"
PORT=3000
NODE_ENV=development

# Redis
REDIS_URL="redis://localhost:6379"

# Kingsoft API (Phase 2)
KINGSOFT_API_BASE_URL="https://openapi.wps.cn/kopen/office/file"
KINGSOFT_API_KEY=""
KINGSOFT_API_SECRET=""

# LLM / AI Coaching (Phase 2)
LLM_PROVIDER="deepseek"              # deepseek | qwen | glm | sensenova | ollama
LLM_API_KEY=""                       # sk-...
LLM_BASE_URL=""                      # 留空=用 provider 默认端点；自托管 OpenAI 兼容端点时覆盖
LLM_MODEL="deepseek-chat"
LLM_TEMPERATURE="0.4"
LLM_MAX_TOKENS="2048"
LLM_TIMEOUT_MS="60000"
LLM_RATE_LIMIT_PER_MIN="20"          # 每教师限流
